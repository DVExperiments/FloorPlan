{
  "id": "./mobile.html",
  "name": "Floorplan Studio Mobile",
  "short_name": "Floorplan Studio",
  "description": "Design, furnish, and explore your dream home in 2D and 3D.",
  "start_url": "./mobile.html",
  "scope": "./",
  "display": "standalone",
